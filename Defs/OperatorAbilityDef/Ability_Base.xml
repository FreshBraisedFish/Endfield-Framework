<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="PawnFlyerBase">
		<defName>EF_Dash</defName>
		<pawnFlyer>
			<flightSpeed>500</flightSpeed>
			<flightDurationMin>0.1</flightDurationMin>
			<heightFactor>0</heightFactor>
			<stunDurationTicksRange>0~0</stunDurationTicksRange>
		</pawnFlyer>
	</ThingDef>

	<ThingDef ParentName="PawnFlyerBase">
		<defName>EF_Jump</defName>
		<pawnFlyer>
			<flightSpeed>200</flightSpeed>
			<flightDurationMin>0.5</flightDurationMin>
			<heightFactor>1.5</heightFactor>
			<stunDurationTicksRange>0~0</stunDurationTicksRange>
		</pawnFlyer>
	</ThingDef>

	<ThingDef ParentName="PawnFlyerBase">
		<defName>EF_Lift</defName>
		<pawnFlyer>
			<flightSpeed>1000</flightSpeed>
			<flightDurationMin>0.1</flightDurationMin>
			<heightFactor>4.5</heightFactor>
			<stunDurationTicksRange>0~0</stunDurationTicksRange>
		</pawnFlyer>
	</ThingDef>

	<!-- 冲刺 -->
	<AbilityDef>
		<defName>EF_Ability_Dash</defName>
		<label>Dash</label>
		<description>Dash.</description>
		<iconPath>UI/Abilities/Dash</iconPath>
		<cooldownTicksRange>60</cooldownTicksRange>
		<hostile>false</hostile>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<verbProperties>
			<verbClass>Verb_CastAbility</verbClass>
			<range>2.9</range>
			<minRange>0.9</minRange>
			<warmupTime>0.01</warmupTime>
			<drawAimPie>true</drawAimPie>
			<targetParams>
			<canTargetLocations>true</canTargetLocations>
			<canTargetPawns>false</canTargetPawns>
			<canTargetBuildings>false</canTargetBuildings>
			</targetParams>
		</verbProperties>
		<comps>
			<li Class="BF_Library.BF_CompProperties_Charge">
				<chargeToTarget>true</chargeToTarget>
				<chargeFlyerDef>EF_Dash</chargeFlyerDef>
				<stunTargetDuringCharge>false</stunTargetDuringCharge>
			</li>
		</comps>
	</AbilityDef>

	<!-- 光环 -->
	 <AbilityDef Abstract="True" Name="EF_AuraBuffBase">
    <jobDef>CastAbilityOnThing</jobDef>
    <targetRequired>False</targetRequired>
    <canUseAoeToGetTargets>False</canUseAoeToGetTargets>
    <stunTargetWhileCasting>False</stunTargetWhileCasting>
    <showPsycastEffects>False</showPsycastEffects>
    <sendMessageOnCooldownComplete>false</sendMessageOnCooldownComplete>
    <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted>
    <statBases>
      <Ability_Duration>1000</Ability_Duration>
      <Ability_EffectRadius>9.9</Ability_EffectRadius>
    </statBases>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0.5</warmupTime>
      <range>9.9</range>
      <drawAimPie>False</drawAimPie>
      <requireLineOfSight>False</requireLineOfSight>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetHumans>false</canTargetHumans>
        <canTargetMechs>false</canTargetMechs>
      </targetParams>
    </verbProperties>
  </AbilityDef>
	<!-- Endfield 专用 operatorID（容器技能） -->
	<AbilityDef>
		<defName>EF_VAbility_Operator</defName>
		<abilityClass>AK_DLL.VAbility_Operator</abilityClass>
		<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
		<!--<label>干员协议</label> -->
		<label>operator protocol</label>
		<!--<description>终末地干员协议。</description> -->
		<description>Endfield operator protocol.</description>
		<iconPath>UI/Element/Endfield</iconPath>
		<verbProperties> <!-- 没用，但没有好像会报错 -->
			<verbClass>Verb_CastPsycast</verbClass>
			<range>24.9</range>
			<requireLineOfSight>True</requireLineOfSight>
			<warmupTime>1</warmupTime>
			<targetParams>
				<canTargetBuildings>False</canTargetBuildings>
				<canTargetAnimals>False</canTargetAnimals>
			</targetParams>
		</verbProperties>
	</AbilityDef>

	<!-- 再生 -->
	<HediffDef>
		<defName>EF_Ability_Heal</defName>
		<label>Heal</label>
		<description>Heal.</description>
		<lethalSeverity>-1</lethalSeverity>
		<maxSeverity>1</maxSeverity>
		<alwaysShowSeverity>false</alwaysShowSeverity>
		<hediffClass>HediffWithComps</hediffClass>
		<keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
		<stages>
			<li>
				<regeneration>30000</regeneration>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>600</disappearsAfterTicks>
			</li>
		</comps>
	</HediffDef>

	<!-- 破防 -->
	<HediffDef>
		<defName>EF_Hediff_Vulnerable</defName>
		<label>vulnerable</label>
		<hediffClass>HediffWithComps</hediffClass>
		<description>Vulnerable can be consumed for further damage.</description>
		<lethalSeverity>-1</lethalSeverity>
		<maxSeverity>1</maxSeverity>
		<alwaysShowSeverity>true</alwaysShowSeverity>
		<stages>
			<li>
				<label>stack 1</label>
				<minSeverity>0.01</minSeverity>
			</li>
			<li>
				<label>stack2</label>
				<minSeverity>0.26</minSeverity>
			</li>
			<li>
				<label>stack 3</label>
				<minSeverity>0.51</minSeverity>
			</li>
			<li>
				<label>stack4</label>
				<minSeverity>0.76</minSeverity>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>1800</disappearsAfterTicks>
			</li>
		</comps>
	</HediffDef>
	
</Defs>
