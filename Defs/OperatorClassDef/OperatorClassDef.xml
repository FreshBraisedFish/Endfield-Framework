		 [BF] - Endfield 干员系列 & 职业定义
		 
		 OperatorSeriesDef — 阵营系列（如：终末地、阵营系列等）
		 OperatorClassDef — 职业分类（决定立绘文件夹、图标、排序等）
		 ============================================================ -->

	<!-- 系列：终末地 -->
	<AK_DLL.OperatorSeriesDef>
		<defName>EF_Series_Endfield</defName>
		<!--<label>终末地</label> -->
		<label>Endfield</label>
