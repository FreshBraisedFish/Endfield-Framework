<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- ============================================================
		 [BF] - Endfield 干员基底定义（独立版，不再依赖 MIS / AK_DLL）
		 每个职业一个抽象 OperatorDef，绑定职业特质与职业分类。
		 具体干员继承这些基底，写在 Defs/OperatorDef/ 下。
	============================================================ -->

	<Endfield.OperatorDef Name="EF_RecruitBase" Abstract="True">
		<surname>Endfield</surname>
		<description>An operator from Endfield.</description>
		<bodyTypeDef>Thin</bodyTypeDef>
		<skinColor>(0.9804, 0.902, 0.8235, 1.0)</skinColor>
		<hairColor>(1, 1, 1, 1)</hairColor>
		<age>18</age>
		<headTypeDef>Female_AverageNormal</headTypeDef>
		<xenoType>Baseliner</xenoType>
	</Endfield.OperatorDef>

	<!-- 近卫 -->
	<Endfield.OperatorDef ParentName="EF_RecruitBase" Name="EF_RecruitBase_Guard" Abstract="True">
		<traits>
			<li><def>EF_Trait_Agent_Guard</def></li>
		</traits>
		<operatorType>EF_OperatorClass_Guard</operatorType>
	</Endfield.OperatorDef>

	<!-- 重装 -->
	<Endfield.OperatorDef ParentName="EF_RecruitBase" Name="EF_RecruitBase_Defender" Abstract="True">
		<traits>
			<li><def>EF_Trait_Agent_Defender</def></li>
		</traits>
		<operatorType>EF_OperatorClass_Defender</operatorType>
	</Endfield.OperatorDef>

	<!-- 辅助 -->
	<Endfield.OperatorDef ParentName="EF_RecruitBase" Name="EF_RecruitBase_Supporter" Abstract="True">
		<traits>
			<li><def>EF_Trait_Agent_Supporter</def></li>
		</traits>
		<operatorType>EF_OperatorClass_Supporter</operatorType>
	</Endfield.OperatorDef>

	<!-- 先锋 -->
	<Endfield.OperatorDef ParentName="EF_RecruitBase" Name="EF_RecruitBase_Vanguard" Abstract="True">
		<traits>
			<li><def>EF_Trait_Agent_Vanguard</def></li>
		</traits>
		<operatorType>EF_OperatorClass_Vanguard</operatorType>
	</Endfield.OperatorDef>

	<!-- 突击 -->
	<Endfield.OperatorDef ParentName="EF_RecruitBase" Name="EF_RecruitBase_Striker" Abstract="True">
		<traits>
			<li><def>EF_Trait_Agent_Striker</def></li>
		</traits>
		<operatorType>EF_OperatorClass_Striker</operatorType>
	</Endfield.OperatorDef>

	<!-- 术士 -->
	<Endfield.OperatorDef ParentName="EF_RecruitBase" Name="EF_RecruitBase_Caster" Abstract="True">
		<traits>
			<li><def>EF_Trait_Agent_Caster</def></li>
		</traits>
		<operatorType>EF_OperatorClass_Caster</operatorType>
	</Endfield.OperatorDef>

</Defs>