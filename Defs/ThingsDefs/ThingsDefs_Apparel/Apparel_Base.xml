<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- ============================================================
		 [BF] - Endfield 服装基类定义
		 每个职业一个抽象 ArmorBase，继承自 ApparelBase，
		 绑定对应职业的物品分类，设定基础护甲值和穿戴属性修正。
		 
		 具体干员服装继承自 EF_ArmorBase_XXX 并覆盖贴图路径即可。
		 ============================================================ -->

	<!-- ========== 通用服装基底 ========== -->

	<ThingDef Name="EF_ArmorBase" ParentName="ApparelBase" Abstract="True">
		<defName>EF_ArmorBase</defName>
		<!-- <label>终末地基础装束</label>-->
		<label>Endfield basic apparel</label>
		<smeltable>false</smeltable>
		<!-- <description>干员平时最常穿着的服装。</description>-->
		<description>The apparel that the operator usually wear most frequently.</description>
		<useHitPoints>false</useHitPoints>
		<techLevel>Undefined</techLevel>
		<graphicData>
			<texPath>Things/Pawn/Humanlike/Apparel/FlakVest/FlakVest</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.50</drawSize>
		</graphicData>
		<statBases>
			<Mass>4</Mass>
			<Flammability>0</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
			<Beauty>15</Beauty>
			<ArmorRating_Sharp>0.40</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.20</ArmorRating_Blunt>
			<ArmorRating_Heat>0.20</ArmorRating_Heat>
			<Insulation_Cold>1</Insulation_Cold>
			<EquipDelay>5</EquipDelay>
		</statBases>
		<thingCategories Inherit="false">
			<li>EF_Apparel</li>
		</thingCategories>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
			</bodyPartGroups>
			<wornGraphicPath>Things/Pawn/Humanlike/Apparel/FlakVest/FlakVest</wornGraphicPath>
			<layers>
				<li>OnSkin</li>
				<li>Middle</li>
				<li>Shell</li>
			</layers>
			<canBeDesiredForIdeo>false</canBeDesiredForIdeo>
		</apparel>
		<colorGenerator Class="ColorGenerator_Options" Inherit="false">
			<options>
				<li>
					<only>(255,255,255)</only>
				</li>
			</options>
		</colorGenerator>
		<burnableByRecipe>false</burnableByRecipe>
		<relicChance>0</relicChance>
		<tradeability>None</tradeability>
		<tickerType>Never</tickerType>
		<generateCommonality>0</generateCommonality>
		<generateAllowChance>0</generateAllowChance>
		<randomizeRotationOnSpawn>false</randomizeRotationOnSpawn>
		<canLoadIntoCaravan>false</canLoadIntoCaravan>
		<comps>
			<li Class="CompProperties_Biocodable"/>
			<li Class="SFLib.TCP_HideBody">
				<hideBody>false</hideBody>
				<hideHead>false</hideHead>
			</li>
		</comps>
		<equippedStatOffsets>
			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">1</VacuumResistance>
		</equippedStatOffsets>
	</ThingDef>

	<ThingDef Name="EF_HeadgearBase" ParentName="ApparelBase" Abstract="True">
		<defName>EF_HeadgearBase</defName>
		<!-- <label>终末地基础头饰</label>-->
		<label>Endfield basic headgear</label>
		<smeltable>false</smeltable>
		<!-- <description>干员平时最常戴着的头饰。</description>-->
		<description>The headgear that the operator usually wear most frequently.</description>
		<useHitPoints>false</useHitPoints>
		<techLevel>Undefined</techLevel>
		<graphicData>
			<texPath>Things/Pawn/Humanlike/Apparel/CowboyHat/CowboyHat</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(0.9,0.9)</drawSize>
		</graphicData>
		<statBases>
			<Mass>1</Mass>
			<Flammability>0</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
			<Beauty>15</Beauty>
			<ArmorRating_Sharp>0.40</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.20</ArmorRating_Blunt>
			<ArmorRating_Heat>0.20</ArmorRating_Heat>
			<Insulation_Cold>1</Insulation_Cold>
			<EquipDelay>5</EquipDelay>
		</statBases>
		<thingCategories Inherit="false">
			<li>EF_Headgear</li>
		</thingCategories>
		<apparel>
			<bodyPartGroups>
				<li>FullHead</li>
				<li>Neck</li>
			</bodyPartGroups>
			<wornGraphicPath>Things/Pawn/Humanlike/Apparel/CowboyHat/CowboyHat</wornGraphicPath>
			<layers>
				<li>Overhead</li>
			</layers>
			<canBeDesiredForIdeo>false</canBeDesiredForIdeo>
		</apparel>
		<colorGenerator Class="ColorGenerator_Options" Inherit="false">
			<options>
				<li>
					<only>(255,255,255)</only>
				</li>
			</options>
		</colorGenerator>
		<burnableByRecipe>false</burnableByRecipe>
		<relicChance>0</relicChance>
		<tradeability>None</tradeability>
		<tickerType>Never</tickerType>
		<generateCommonality>0</generateCommonality>
		<generateAllowChance>0</generateAllowChance>
		<randomizeRotationOnSpawn>false</randomizeRotationOnSpawn>
		<canLoadIntoCaravan>false</canLoadIntoCaravan>
		<comps>
			<li Class="CompProperties_Biocodable"/>
			<li Class="SFLib.TCP_HideBody">
				<hideBody>false</hideBody>
				<hideHead>false</hideHead>
			</li>
		</comps>
		<equippedStatOffsets>
			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">1</VacuumResistance>
		</equippedStatOffsets>
	</ThingDef>

	<!-- ========== 近卫 Guard ========== -->

