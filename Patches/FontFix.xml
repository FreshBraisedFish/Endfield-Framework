<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- 修改默认 UGUI 字体为 msyhl，修复英文字体乱码 -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/FS_UGUIFramework.ConfigDef[defName="AK_Config_UGUI"]/defaultFont</xpath>
    <value>
      <defaultFont>AK_Font_msyhl</defaultFont>
    </value>
  </Operation>
</Patch>
